            <td width="16%"><p>&nbsp;</td>
            <td width="16%"><p>{{doc.paid_amount or ''}}</td>
          </tr>
          <tr>
            <td width="19%">{{doc.paid_from or ""}}</td>
            <td width="19%">{{doc.reference_no or ""}}</td>
            <td width="16%">{{doc.cost_center or ""}}</td>
    		<td>{{doc.unit or ""}}</td>
            <td width="16%"><p>{{doc.paid_amount or ''}}</td>
            <td width="16%"><p>&nbsp;</td>
          </tr>
      {% endif %}
      <tr>
	    <td>&nbsp;</td>
        <td>&nbsp;</td>
        <td>&nbsp;</td>        <td><div align="right"><strong>Total</strong></div></td>
        <!--<td><p>{{ doc.references | map(attribute='outstanding_amount') | join(', ') }}</td>-->
        <!--<td><p>{{ doc.references | map(attribute='allocated_amount') | join(', ') }}</td>-->
        <td><p>{{ doc.paid_amount or '' }}</td>
        <td><p>{{ doc.paid_amount or ''}}</td>
    </tr>
</table>
	 <table width="100%">
