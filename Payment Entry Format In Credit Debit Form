    		<td>{{doc.unit or ""}}</td>
            <td width="16%"><p>&nbsp;</td>
            <td width="16%"><p>{{doc.paid_amount or ''}}</td>
          </tr>
      {% elif doc.payment_type == 'Receive' %}
          <tr>
            <td width="19%">{{doc.party_name or ""}}</td>
