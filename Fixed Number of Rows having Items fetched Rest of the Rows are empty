{% set ns = {'row_count': 0} %}
{% for i in doc.items %}
<tr>
  <td>{{ i.item_code or '' }}</td>
  <td>{{ i.description or '' }}</td>
  <td>{{ i.qty or '' }}</td>
  <td>{{ i.uom or '' }}</td>
  <td>{{ i.packing or '' }}</td>
  <td>{{ i.ctn or '' }}</td>
  <td>{{ i.get_formatted('rate') or '' }}</td>
  <td>{{ i.get_formatted('amount') or '' }}</td>
  <td>{{ i.cbm_vol or '' }}</td>
</tr>
{% set ns['row_count'] = ns['row_count'] + 1 %}
{% endfor %}

{# Add empty rows if less than 14 items #}
{% for x in range(14 - ns['row_count']) %}
<tr>
  <td>&nbsp;</td>
  <td>&nbsp;</td>
  <td>&nbsp;</td>
  <td>&nbsp;</td>
  <td>&nbsp;</td>
  <td>&nbsp;</td>
  <td>&nbsp;</td>
  <td>&nbsp;</td>
  <td>&nbsp;</td>
</tr>
{% endfor %}
