{% set total_rows = 14 %}
{% for i in range(total_rows) %}
  {% set row = doc.items[i] if i < doc.items|length else None %}
  <tr>
    <td><div align="center">{{ row.idx if row else '' }}</div></td>
    <td><div align="center">{{ row.item_code if row else '' }}</div></td>
    <td><div align="center">{{ row.description if row else '' }}</div></td>
    <td><div align="center">{{ row.qty if row else '' }}</div></td>
    <td><div align="center">{{ row.bins if row else '' }}</div></td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
  </tr>
{% endfor %}
