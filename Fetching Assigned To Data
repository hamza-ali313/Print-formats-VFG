<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TASK</title>
</head>

<body>
    <table width="100%">
        <tr>
            <td colspan="6" align="center"><h1 style="font-weight: bold;"><U>TASK</U></h1></td>
        </tr>
        <tr>
            <td colspan="6" align="center"><h1 style="font-weight: bold;">&nbsp;</h1></td>
        </tr>
        <tr style="font-size: 10px;">
            <td width="14%" style="font-size: 10px; font-weight: bold;">Date</td>
            <td width="43%">: {{doc.get_formatted('exp_start_date') or ''}}</td>
            <td width="15%" style="font-size: 10px; font-weight: bold;">Task No</td>
            <td width="28%">: {{doc.name or ''}}</td>
        </tr>
        <tr style="font-size: 10px;">
            <td width="14%" style="font-size: 10px; font-weight: bold;">Assigned By</td>
            <td width="43%">: {{doc.employee_name or ''}} </td>
            <td width="15%" style="font-size: 10px; font-weight: bold;">Department</td>
            <td width="28%">: {{doc.department or ''}}</td>
            <!-- <td width="17%">Designation : </td>
            <td width="16%">&nbsp; </td> -->
        </tr>
        <tr style="font-size: 10px;">
            <td width="15%" style="font-size: 10px; font-weight: bold;">Priority</td>
            <td width="28%">: {{doc.priority or ''}}</td>
            <td width="14%" style="font-size: 10px; font-weight: bold;">Target Date</td>
            <td width="43%">: {{doc.get_formatted('exp_end_date') or ''}}</td>
        </tr>
        <tr>
            <td height="2px">&nbsp;</td>
        </tr>
        <tr style="font-size: 12px; font-weight: bold;">
            <td width="14%">SUBJECT : </td>
            <td colspan="5" style="font-size: 14px;"><u>{{doc.subject or ''}}</u></td>
        </tr>
        <tr colspan="6" style="font-size: 10px; font-weight: bold;">
            <td width="14%">Task Details: </td>
      <tr style="line-height: 1px;">
            </tr>
        <td colspan="6" style="font-size: 12px; border: 1px solid black;">{{doc.description or ''}}</td>
        </tr>
    </table>
    
    {% set assigned_users = frappe.get_all('ToDo', 
    filters={'reference_name': doc.name, 'reference_type': doc.doctype},
    fields=['allocated_to']
    ) %}

{% if assigned_users %}
    {% set user_ids = assigned_users | map(attribute='allocated_to') | list %}
    <!--{{user_ids}}-->
{% set employee_names = frappe.db.get_all('Employee',
    filters=[['company_email', 'in', user_ids], ['prefered_email', 'in', user_ids]],
    fields=['first_name', 'department']
) %}
<!--{{employee_names}}-->

<p>&nbsp;</p>
<p>&nbsp;</p>
    <table width='100%' border='1'>
        <tr>
            <td style="font-size: 10px; font-weight: bold;" align='center'><strong>Assigned To</strong></td>
            <td style="font-size: 10px; font-weight: bold;" align='center'><strong>Department</strong></td>
        </tr>
        {% for user in employee_names %}
            <tr>
                <td align='center' style="font-size: 10px;">{{ user.first_name }}</td>
                <td align='center' style="font-size: 10px;">{{ user.department }}</td>
            </tr>
        {% endfor %}
    </table>
{% endif %}

</body>

</html>
